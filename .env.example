# ==============================================================================
# LabourLens Root Environment Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Database: Neon Cloud Serverless PostgreSQL (with PostGIS extension enabled)
# Note: Local PostgreSQL is NOT supported; use your Neon connection string with SSL
DATABASE_URL="postgresql://<neon_user>:<neon_password>@<neon_host>.neon.tech/labourlens?sslmode=require"
DIRECT_URL="postgresql://<neon_user>:<neon_password>@<neon_host>.neon.tech/labourlens?sslmode=require"

# NestJS Backend API
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="your-jwt-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-chars-long"
CORS_ORIGIN="http://localhost:3000"

# AI Matching Service (Python FastAPI)
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_API_KEY="replace-with-a-random-service-secret"

# Redis Cache / Upstash
REDIS_URL="redis://default:<password>@<host>:<port>"

# Cloud Storage (AWS S3 / Cloudflare R2 / MinIO for CNIC & Police Certificates)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET_NAME="labourlens-verification-docs"
