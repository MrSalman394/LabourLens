# LabourLens Web Environment Configuration (.env.example)
# Public variables exposed to browser (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME="LabourLens"
NEXT_PUBLIC_APP_TAGLINE="Explainable AI-Based Matching for Domestic & Skilled Workers in Pakistan"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_MAP_DEFAULT_LAT="31.5204"
NEXT_PUBLIC_MAP_DEFAULT_LNG="74.3436"
NEXT_PUBLIC_MAP_DEFAULT_CITY="Lahore"

# Never expose database credentials or secret keys in NEXT_PUBLIC_ variables!
# Server-only configurations (used by Next.js Server Components / API proxy if needed)
# BACKEND_INTERNAL_URL="http://localhost:4000"
