# Database connection
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/labourlens_db?schema=public"

# Application
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# JWT Authentication
JWT_SECRET="your_jwt_access_secret_min_32_characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters"
JWT_REFRESH_EXPIRES_IN="7d"

# Private administrator provisioning (CNIC and phone are never logged)
ADMIN_CNIC="0000000000000"
ADMIN_NAME="Platform Administrator"
ADMIN_PHONE=""
ADMIN_PASSWORD="replace-with-a-unique-random-secret"

# Security & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=20
